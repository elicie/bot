{
  "name": "grok-bot-q",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run build && npm run start:server",
    "start": "npm run start:server",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "node scripts/desktop.mjs build",
    "dev:desktop": "node scripts/desktop.mjs dev",
    "build:release": "npm run build && node scripts/cargo.mjs build --locked --release -p grok-bot-server",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:server": "node scripts/cargo.mjs build --locked -p grok-bot-server",
    "start:server": "node scripts/cargo.mjs run --locked -p grok-bot-server",
    "test:rust": "node scripts/cargo.mjs test --locked --workspace"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.3",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
