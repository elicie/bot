{
  "name": "grok-bot-q",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:engine": "node scripts/build-engine.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.2.0",
    "cron-parser": "^5.10.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
