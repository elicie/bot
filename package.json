{
  "name": "grok-bot-q",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:engine": "node scripts/build-engine.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build:server": "node scripts/cargo.mjs build --locked -p grok-bot-server",
    "start:server": "node scripts/cargo.mjs run --locked -p grok-bot-server",
    "test:rust": "node scripts/cargo.mjs test --locked --workspace",
    "test:e2e:rust": "GROK_BOT_BACKEND=rust playwright test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.2.0",
    "cron-parser": "^5.10.3",
    "d3": "^7.9.0",
    "express": "^5.1.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "mdast-util-from-markdown": "2.1.0",
    "mermaid": "^11.17.2",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-cjk-friendly": "^2.3.3",
    "remark-math": "^6.0.0",
    "yaml": "2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
